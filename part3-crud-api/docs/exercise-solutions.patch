diff -ruN a/tests/test_exercises.cpp b/tests/test_exercises.cpp
--- a/tests/test_exercises.cpp	1969-12-31 19:00:00
+++ b/tests/test_exercises.cpp	2026-10-03 10:45:02
@@ -0,0 +1,121 @@
+// HTTP-level tests for the part 3 exercise solutions.
+#include <doctest/doctest.h>
+
+#include <thread>
+
+#include <httplib.h>
+#include <nlohmann/json.hpp>
+
+#include "http/routes.hpp"
+#include "repository/memory_task_repository.hpp"
+
+using namespace tasks;
+using json = nlohmann::json;
+
+namespace {
+
+class Srv {
+public:
+    explicit Srv(http::RouteOptions opts = {}) {
+        http::register_routes(server_, service_, logger_, opts);
+        port_ = server_.bind_to_any_port("127.0.0.1");
+        thread_ = std::jthread([this] { server_.listen_after_bind(); });
+        server_.wait_until_ready();
+    }
+    ~Srv() { server_.stop(); }
+    httplib::Client client() const { return httplib::Client("127.0.0.1", port_); }
+
+private:
+    Logger logger_{LogLevel::Error};
+    MemoryTaskRepository repo_;
+    TaskService service_{repo_};
+    httplib::Server server_;
+    int port_{};
+    std::jthread thread_;
+};
+
+constexpr const char* kJson = "application/json";
+
+} // namespace
+
+TEST_CASE("EX1: GET /tasks/stats") {
+    Srv srv;
+    auto cli = srv.client();
+    cli.Post("/tasks", R"({"title":"a","priority":"high"})", kJson);
+    cli.Post("/tasks", R"({"title":"b","status":"done","due_date":"2000-01-01"})", kJson);
+    cli.Post("/tasks", R"({"title":"c","due_date":"2000-01-01"})", kJson);
+    auto r = cli.Get("/tasks/stats");
+    REQUIRE(r);
+    CHECK(r->status == 200);
+    auto s = json::parse(r->body);
+    CHECK(s["total"] == 3);
+    CHECK(s["by_status"]["todo"] == 2);
+    CHECK(s["by_status"]["in_progress"] == 0); // zeros are present
+    CHECK(s["by_priority"]["high"] == 1);
+    CHECK(s["overdue"] == 1);
+}
+
+TEST_CASE("EX2: API key authentication") {
+    Srv srv({.api_key = "s3cret"});
+    auto cli = srv.client();
+    CHECK(cli.Get("/health")->status == 200); // health stays public
+    auto denied = cli.Get("/tasks");
+    CHECK(denied->status == 401);
+    CHECK(denied->get_header_value("WWW-Authenticate") == "Bearer");
+    CHECK(cli.Get("/tasks", {{"Authorization", "Bearer wrong!"}})->status == 401);
+    CHECK(cli.Get("/tasks", {{"Authorization", "Bearer s3cret"}})->status == 200);
+}
+
+TEST_CASE("EX3: ETag and If-Match") {
+    Srv srv;
+    auto cli = srv.client();
+    auto created = cli.Post("/tasks", R"({"title":"doc"})", kJson);
+    CHECK(created->get_header_value("ETag") == "\"1\"");
+
+    auto ok = cli.Patch("/tasks/1", {{"If-Match", "\"1\""}}, R"({"title":"doc v2"})", kJson);
+    CHECK(ok->status == 200);
+    CHECK(ok->get_header_value("ETag") == "\"2\"");
+
+    auto stale = cli.Patch("/tasks/1", {{"If-Match", "\"1\""}}, R"({"title":"lost update"})", kJson);
+    CHECK(stale->status == 412);
+    CHECK(json::parse(stale->body)["error"]["code"] == "precondition_failed");
+
+    CHECK(cli.Patch("/tasks/1", R"({"title":"no header = last write wins"})", kJson)->status == 200);
+    CHECK(cli.Patch("/tasks/1", {{"If-Match", "garbage"}}, R"({"title":"x"})", kJson)->status == 422);
+}
+
+TEST_CASE("EX4: POST /tasks/bulk-complete") {
+    Srv srv;
+    auto cli = srv.client();
+    for (int i = 0; i < 3; ++i) cli.Post("/tasks", R"({"title":"t"})", kJson);
+    auto r = cli.Post("/tasks/bulk-complete", R"({"ids":[1,2,2,99]})", kJson);
+    CHECK(r->status == 200);
+    CHECK(json::parse(r->body)["updated"] == 2);
+    CHECK(json::parse(cli.Get("/tasks?status=done")->body)["total"] == 2);
+    CHECK(cli.Post("/tasks/bulk-complete", R"({"ids":[]})", kJson)->status == 422);
+    CHECK(cli.Post("/tasks/bulk-complete", R"({"ids":["1"]})", kJson)->status == 422);
+}
+
+TEST_CASE("EX5: shape and rule errors are reported together") {
+    Srv srv;
+    auto r = srv.client().Post("/tasks", R"({"title":"   ","priority":"urgent","due_date":"2026-02-30"})", kJson);
+    CHECK(r->status == 422);
+    auto details = json::parse(r->body)["error"]["details"];
+    CHECK(details.contains("title"));    // rule
+    CHECK(details.contains("priority")); // shape
+    CHECK(details.contains("due_date")); // rule
+}
+
+TEST_CASE("EX6: rate limiting") {
+    Srv srv({.rate_limit_rps = 1, .rate_limit_burst = 3});
+    auto cli = srv.client();
+    int ok = 0, limited = 0;
+    for (int i = 0; i < 6; ++i) {
+        auto r = cli.Get("/tasks");
+        (r->status == 200 ? ok : limited)++;
+        if (r->status == 429) CHECK(r->get_header_value("Retry-After") == "1");
+    }
+    CHECK(ok == 3);      // the burst
+    CHECK(limited == 3);
+    CHECK(cli.Get("/health")->status == 200); // never limited
+}
